if(NOT DEFINED BUILD_DIRECTORY OR NOT EXISTS "${BUILD_DIRECTORY}/cmake_install.cmake")
  message(FATAL_ERROR "A configured build directory is required.")
endif()
if(NOT PACKAGE_PLATFORM MATCHES "^(windows-x64|macos-arm64)$")
  message(FATAL_ERROR "Unsupported package platform.")
endif()
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/.." project_root)
file(REAL_PATH "${BUILD_DIRECTORY}" build_directory)
set(staging_directory "${build_directory}/package")
file(REAL_PATH "${staging_directory}" resolved_staging)
if(NOT resolved_staging STREQUAL staging_directory)
  message(FATAL_ERROR "Refusing to clean a redirected staging directory.")
endif()
file(REMOVE_RECURSE "${staging_directory}")
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${build_directory}"
  --config "${CONFIG}" --prefix "${staging_directory}" COMMAND_ERROR_IS_FATAL ANY)
if(PACKAGE_PLATFORM STREQUAL "macos-arm64")
  execute_process(COMMAND codesign --force --sign - --timestamp=none "${staging_directory}/obs-beauty.plugin"
    COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND codesign --verify --deep --strict "${staging_directory}/obs-beauty.plugin"
    COMMAND_ERROR_IS_FATAL ANY)
endif()
set(dist_directory "${project_root}/dist")
file(REAL_PATH "${dist_directory}" resolved_dist)
if(NOT resolved_dist STREQUAL dist_directory)
  message(FATAL_ERROR "Refusing to package into a redirected dist directory.")
endif()
file(MAKE_DIRECTORY "${dist_directory}")
execute_process(COMMAND "${PYTHON_EXECUTABLE}" "${project_root}/scripts/package.py" "${staging_directory}"
  "${dist_directory}/OBS-Beauty-${PLUGIN_VERSION}-${PACKAGE_PLATFORM}.zip" COMMAND_ERROR_IS_FATAL ANY)
