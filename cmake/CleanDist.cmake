# Only the dist folder directly inside this project may be removed.
file(REAL_PATH "${CMAKE_CURRENT_LIST_DIR}/.." project_root)
set(dist_directory "${project_root}/dist")
if(NOT EXISTS "${dist_directory}")
  file(MAKE_DIRECTORY "${dist_directory}")
endif()
file(REAL_PATH "${dist_directory}" resolved_dist)
if(NOT resolved_dist STREQUAL dist_directory)
  message(FATAL_ERROR "Refusing to clean a redirected dist directory: ${resolved_dist}")
endif()
if(EXISTS "${dist_directory}" AND NOT IS_DIRECTORY "${dist_directory}")
  message(FATAL_ERROR "dist exists but is not a directory.")
endif()
message(STATUS "Clearing ${resolved_dist}")
file(REMOVE_RECURSE "${dist_directory}")
file(MAKE_DIRECTORY "${dist_directory}")
